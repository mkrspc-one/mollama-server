{{#> layout title="Your password was changed" preheader=(concat "The password for your " appName " account was changed on " changeTime ".") reason="because this account's password was changed"}}
<p style="margin:0 0 16px 0;">Hi {{firstName}},</p>
<p style="margin:0 0 24px 0;">The password for the {{appName}} account at <strong>{{email}}</strong> has been changed.</p>
{{#> details}}{{> row label="When" value=changeTime}}{{> row label="Account" value=email}}{{/details}}
{{#> warn}}<strong>Was this not you?</strong> Reset your password now, then check Settings for anything you did not change.{{/warn}}
{{> button url=(concat appUrl "/forgot-password") label="Reset my password"}}
{{/layout}}
