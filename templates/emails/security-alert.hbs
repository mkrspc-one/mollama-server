{{#> layout title="New sign-in to your account" preheader=(concat "Your " appName " account was just signed in to. If this was you, there is nothing to do.") reason="to keep your account safe"}}
<p style="margin:0 0 16px 0;">Hi {{firstName}},</p>
<p style="margin:0 0 24px 0;">Your {{appName}} account at <strong>{{email}}</strong> was just signed in to. If this was you, there is nothing to do.</p>
{{#> details}}{{> row label="When" value=loginTime}}{{#if device}}{{> row label="Device" value=device}}{{/if}}{{#if browser}}{{> row label="Browser" value=browser}}{{/if}}{{#if location}}{{> row label="Place" value=location}}{{/if}}{{#if ipAddress}}{{> row label="Address" value=ipAddress}}{{/if}}{{/details}}
{{#> warn}}<strong>Was this not you?</strong> Reset your password now, then check Settings for anything you did not change.{{/warn}}
{{> button url=(concat appUrl "/forgot-password") label="Reset my password"}}
{{/layout}}
