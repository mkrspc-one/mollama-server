{{#> layout title="New message from the contact form" preheader=(concat name " wrote through the contact form.") reason="as the contact form's inbox"}}
<p style="margin:0 0 24px 0;">Reply to this email to answer {{name}} directly.</p>
{{#> details}}{{> row label="Name" value=name}}{{> row label="Email" value=email}}{{> row label="Phone" value=phone}}{{/details}}
{{#> note}}<span style="white-space:pre-wrap;">{{description}}</span>{{/note}}
{{/layout}}
