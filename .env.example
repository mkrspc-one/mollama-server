# ==============================================================================
# APPLICATION CONFIGURATION
# ==============================================================================

# Application name (used in logs, emails, and 2FA setup)
APP_NAME=Mollama

# Server port (Render sets this automatically in production)
PORT=8090

# Environment mode: development, production, or test
NODE_ENV=development


# ==============================================================================
# DATABASE CONFIGURATION
# ==============================================================================

# MongoDB Atlas connection string
# Replace: username, password, cluster.example.mongodb.net, database-name, app-name
MONGODB_URI=mongodb+srv://username:password@cluster.example.mongodb.net/database-name?retryWrites=true&w=majority&appName=app-name


# ==============================================================================
# AUTHENTICATION & SECURITY
# ==============================================================================

# JWT Access Token Secret (generate using: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))")
ACCESS_TOKEN_SECRET=replace_with_random_generated_secret_at_least_32_chars_long

# JWT Refresh Token Secret (generate a different secret from access token)
REFRESH_TOKEN_SECRET=replace_with_different_random_generated_secret_at_least_32_chars_long

# Token expiration times (format: 20m, 1h, 7d, etc.)
ACCESS_TOKEN_EXPIRY=20m
REFRESH_TOKEN_EXPIRY=7d
# bcrypt cost factor for password hashing. Do not lower this in production.
BCRYPT_ROUNDS=12



# ==============================================================================
# REDIS CACHE CONFIGURATION
# ==============================================================================

# Enable or disable Redis caching (true/false)
CACHE_ENABLED=true

# Redis connection URL (supports local and cloud deployments)
REDIS_URL=redis://localhost:6379

# Cache cleanup service configuration
CACHE_CLEANUP_ENABLED=true
CACHE_CLEANUP_INTERVAL_HOURS=24
CACHE_CLEANUP_MIN_AGE_HOURS=2
CACHE_CLEANUP_MAX_KEYS_PER_RUN=500


# ==============================================================================
# REQUEST LIMITS
# ==============================================================================

# Maximum request payload size (controls file upload limit)
MAX_REQUEST_SIZE=500mb


# ==============================================================================
# RATE LIMITING
# ==============================================================================

# General API rate limiting (applies to /api/* routes)
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=1000

# Authentication rate limiting (applies to /api/v1/auth/* routes)
RATE_LIMIT_AUTH_WINDOW_MS=60000
RATE_LIMIT_AUTH_MAX_REQUESTS=100


# ==============================================================================
# LOGGING
# ==============================================================================

# Log level (options: error, warn, info, http, verbose, debug, silly)
LOG_LEVEL=http


# ==============================================================================
# CORS CONFIGURATION
# ==============================================================================

# Allowed origins (comma-separated list)
ALLOWED_ORIGINS=http://localhost:8090,http://localhost:8092,http://localhost:8093,http://localhost:8098


# ==============================================================================
# EMAIL SERVICE (SMTP)
# ==============================================================================

# Enable or disable email service (true/false)
EMAIL_ENABLED=true

# SMTP server configuration
EMAIL_HOST=smtp.example.com
EMAIL_PORT=587
EMAIL_USER=your-email@example.com
EMAIL_PASS=your_email_password_or_app_password

# Email sender address
EMAIL_FROM=noreply@example.com

# Application URL (used in email links for verification, password reset, etc.)
APP_URL=http://localhost:8093 # Development (frontend URL)

# =============================================================================
# OLLAMA
# =============================================================================
# Address of the Ollama API the server talks to
OLLAMA_BASE_URL=http://127.0.0.1:11434

# Address of the FilesystemOne server, used for "From my files" and "Save to my files"
FILESYSTEM_ONE_URL=http://localhost:8080

# Optional. Render Sandboxes, where a program a model writes is run, in a small computer of its own with no network.
# All three set: a chat that has a skill needing commands on is offered run_program (the office skills' own scripts
# run there too), and Hairline's checks run the kit's own scripts. Left empty, no program is run.
# The key is a Render API key (full access to the Render account); keep it only here. SANDBOX_SNAPSHOT is the name
# that mkrspc-python/prepare_sandbox.py gives the prepared snapshot.
SANDBOX_API_KEY=
SANDBOX_WORKSPACE_ID=
SANDBOX_SNAPSHOT=

# Optional. Whether the server's own computer counts as a device that runs models. Leave empty for the
# Not a server setting. A Mollama server, including a local development server, is never one of a person's
# computers: models run only on computers linked through the Mollama desktop app. The test suite alone sets this,
# and it is ignored unless NODE_ENV is test.
LOCAL_DEVICE=

# Optional. Leave empty on one computer. When several apps are hosted under one
# domain and should share a sign-in, set this to that parent domain in each app.
COOKIE_DOMAIN=

# Optional. Set to true on a staging copy so only administrators can sign in or use the API.
# New sign-ups are refused while it is on.
ADMIN_ONLY=false

# Optional. A key from https://tavily.com lets models search the web through Tavily's search service
# (search words are sent to Tavily). Leave empty to keep web search off.
# Pages the model opens are loaded by this server itself.
TAVILY_API_KEY=

# =
# BILLING (STRIPE)
# =

# Optional. Leave both empty and the app has no billing at all. Set both and people can buy prepaid credit
# on Stripe's own checkout page. Use test-mode keys (sk_test_...) everywhere but production.
# The secret key is from Stripe's dashboard (Developers > API keys). The webhook secret (whsec_...) is shown
# when the endpoint <server address>/api/v1/billing/stripe is added under Developers > Webhooks, with the events
# checkout.session.completed, checkout.session.async_payment_succeeded, charge.refunded, charge.dispute.created
# and charge.dispute.closed.
# The Stripe account may be shared with other projects: everything this app makes there carries its own mark
# (metadata service and project), and it acts only on messages that carry it. A restricted key (rk_test_...) is
# enough: it needs to write Checkout Sessions and Refunds. A live key is refused unless NODE_ENV is production.
# On one computer, `stripe listen --forward-to localhost:<port>/api/v1/billing/stripe` passes Stripe's messages on
# and prints the webhook secret to use.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Optional. The publishable key (pk_test_... in test mode) from the same page. With it, people pay inside the
# app's Billing page: Stripe's card field sits in the page and the app's own button pays. Without it, they pay on
# Stripe's checkout page. It is not a secret: the web app is given it to load Stripe's card field.
STRIPE_PUBLISHABLE_KEY=

# =
# RENTED COMPUTERS (RUNPOD FIRST, HYPERSTACK AS FALLBACK)
# =

# Optional. Leave all five empty and nothing can be rented. Set all five (and billing above) and a person can rent
# a graphics card by the hour from the Devices page, paid from prepaid credit.
# HYPERSTACK_API_KEY: the key of a separate, restricted user in Mollama's Hyperstack organisation. It can start and
#   delete machines that cost money, never expires and cannot be limited, so it lives only here, never in a browser,
#   a desktop app or a rented machine.
# HYPERSTACK_ENVIRONMENT: the name of the Hyperstack environment the machines are made in (it fixes the region).
# HYPERSTACK_KEY_NAME: the name of an SSH key pair in that environment (Hyperstack requires one; no door is opened for it).
# RENTAL_SERVER_URL: this server's own public address (https://...), which a rented machine connects out to.
# RENTAL_LABEL: a short name for this copy of Mollama (for example staging or live). Machines are named
#   mollama-<label>-..., and each copy only ever ends machines that carry its own label, so two copies can share
#   one Hyperstack organisation.
# Also run `node watch.js` every five minutes as a scheduled job of its own (a Render cron job with these same
# settings), so a rented machine is still ended on time while this server is down.
HYPERSTACK_API_KEY=
HYPERSTACK_ENVIRONMENT=
HYPERSTACK_KEY_NAME=
RENTAL_SERVER_URL=
RENTAL_LABEL=
# RUNPOD_API_KEY: optional. A RunPod API key (Secure Cloud only is ever used). With it, RunPod is the first provider and
#   Hyperstack, when set up, the fallback for a card RunPod has none of. It needs read and write on pods and read on
#   catalog, billing and account. People are never told which provider runs their machine.
RUNPOD_API_KEY=

# =
# SKILL SEARCH
# =

# Optional. on (the default) or off. Off, a chat's skills are matched by their words alone and the embedding model is
# never loaded. The library's numbers come from instructions/skill-index.bin, made by `npm run index-skills`
# whenever a skill is added or changed.
SKILL_SEARCH=
